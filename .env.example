SECRET_KEY=replace-with-a-secure-random-key

DB_HOST=localhost
DB_PORT=3306
DB_USER=semester_app
DB_PASS=replace-with-your-database-password
DB_NAME=semester_mgt
DB_CONNECT_TIMEOUT=5
SESSION_LIFETIME_MINUTES=30
SESSION_COOKIE_SECURE=false

# Local development only. Keep disabled for normal use.
# Choose AR_OFFICER, HOD, DEAN, or CLERK for the demo role.
DEV_AUTH_BYPASS=false
DEV_AUTH_ROLE=AR_OFFICER
